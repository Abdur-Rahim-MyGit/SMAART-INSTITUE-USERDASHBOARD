# API Configuration
VITE_API_URL=http://localhost:5000/api
# Admin app origin, used for the "For Employers" link. Leave blank to fall
# back to the current origin. Production example: https://admin.example.com
VITE_ADMIN_URL=
# For production, set to your production backend: VITE_API_URL=https://your-backend-domain.com/api

# Supabase Configuration
# NOTE: Supabase is currently installed but NOT actively used in the application.
# All authentication and data operations are handled by the custom Express backend.
# These variables can be removed if Supabase integration is not planned.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
