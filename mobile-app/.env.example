# Copy this file to .env and set it to your backend's LAN address.
#
# - iOS Simulator: http://localhost:5000/api works.
# - Android Emulator: use http://10.0.2.2:5000/api (10.0.2.2 is the emulator's alias for your host machine).
# - Physical device (Expo Go / dev client): use your computer's LAN IP, e.g. http://192.168.1.23:5000/api
#   Find it on Windows with: ipconfig  (look for "IPv4 Address")
#   The backend (back-end/server.js) must be reachable on that IP/port — check its CORS config allows it.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Where to download the ONNX face-verification models (SCRFD + ArcFace R50,
# ~178MB total) from on first launch — see src/facepipeline/modelDownloader.js.
# These are the SAME files the web app serves from front-end/public/models/onnx/,
# so point this at wherever the front-end's static assets are reachable.
# Local dev (front-end's Vite dev server runs on port 8080 in this repo, see front-end/vite.config.ts):
EXPO_PUBLIC_MODEL_BASE_URL=http://localhost:8080/models/onnx
