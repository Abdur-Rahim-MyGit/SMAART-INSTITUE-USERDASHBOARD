# SMAART backend environment variables.
# Copy to `.env` for local dev, or paste these keys into Render's dashboard.
# server.js exits on startup if MONGODB_URI or JWT_SECRET are missing.

# ---- Core (REQUIRED) ----
NODE_ENV=production
PORT=5000                      # Render injects PORT automatically; leave unset there
MONGODB_URI=                   # MongoDB Atlas connection string
JWT_SECRET=                    # long random string

# ---- Frontend / CORS ----
FRONTEND_URL=                  # your Vercel URL, e.g. https://smaart.vercel.app
APP_URL=                       # public app url used in some email/AI links

# ---- Uploads (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=                # optional cloudinary://... form

# ---- Email (nodemailer / SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=                   # recipient for cron/admin notifications

# ---- Admin auth ----
ADMIN_SYSTEM_SECRET=           # long random string

# ---- AI services ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ---- Optional integrations ----
ML_SERVICE_URL=                # career engine ML service, if used
ITSM_URL=                      # ITSM ticketing integration, if used
ITSM_API_KEY=
LOG_LEVEL=info
