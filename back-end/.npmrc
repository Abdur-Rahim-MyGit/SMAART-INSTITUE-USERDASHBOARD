# multer-storage-cloudinary@4 declares a peer dependency on cloudinary 1.x,
# but works fine with cloudinary 2.x at runtime (it only calls the stable
# uploader API). cloudinary was upgraded to 2.x for the GHSA-g4mf-96x5-5m2c
# security fix, so relax npm's strict peer check until multer-storage-cloudinary
# publishes a release that allows cloudinary 2.
legacy-peer-deps=true
