# ============================================================================
# back-end/.env.local.example  —  TEMPLATE for LOCAL Docker testing only
# ----------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file to ".env.local"   (cp .env.local.example .env.local)
#   2. Leave the dummy values as-is for a basic boot test, or fill in real
#      DEV keys for features you want to exercise (email, AI, uploads...).
#   3. `docker compose -f docker-compose.local.yml up --build` reads .env.local.
#
# IMPORTANT:
#   - This file holds NO real secrets and is safe to commit.
#   - ".env.local" (your real copy) is git-ignored — never commit it.
#   - These are LOCAL DEV values. Production secrets live in AWS Secrets
#     Manager, never in a file. See DEPLOYMENT_GUIDE.md.
# ============================================================================

# --- Core (REQUIRED — server refuses to start without these) ----------------
NODE_ENV=development
PORT=5000
# "mongo" is the Docker Compose service name; containers reach it by that name.
MONGODB_URI=mongodb://mongo:27017/smaart_local
JWT_SECRET=local-dev-only-not-a-real-secret-change-me

# --- Frontend origin (CORS). In dev, any localhost is allowed anyway. -------
FRONTEND_URL=http://localhost:5173

# --- Optional integrations: leave blank to run with that feature disabled ---
# AI (career coach / intelligence) — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=

# Email (OTP / notifications) — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Media uploads — Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Speech-to-text — Deepgram
DEEPGRAM_API_KEY=

# OCR / content moderation
OCR_SPACE_API_KEY=
NSFW_THRESHOLD=0.7

# Internal service-to-service tokens
ADMIN_SYSTEM_SECRET=local-dev-admin-secret
USERDASHBOARD_SYNC_TOKEN=local-dev-sync-token
ITSM_URL=
ITSM_API_KEY=
