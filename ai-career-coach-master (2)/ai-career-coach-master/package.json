{
    "name": "ai-career-coach",
    "version": "1.0.0",
    "description": "AI-powered career coaching platform with intelligent recommendations",
    "main": "server.js",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "nodemon backend/server.js",
        "client": "npm start --prefix frontend",
        "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
        "install:all": "npm install && cd frontend && npm install",
        "seed": "node backend/scripts/seedData.js"
    },
    "keywords": [
        "ai",
        "career",
        "coach",
        "mern",
        "openrouter"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.2",
        "bcryptjs": "^2.4.3",
        "compromise": "^14.10.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^1.4.5-lts.1",
        "natural": "^6.10.4",
        "node-cache": "^5.1.2",
        "pdf-parse": "^1.1.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "nodemon": "^3.0.2"
    }
}
