# ==============================================================================
# SECURE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (SMAART Minds Backend)
# Location: /aws-deployment/production-secrets.env.example
# ==============================================================================
# SECURITY CRITICAL: 
# 1. NEVER commit actual production credentials to Git repositories.
# 2. In AWS ECS Fargate, do NOT write secret values in the task definition JSON in plain text.
# 3. Best Practice: Store all values labeled [SECRET] in AWS Secrets Manager or AWS Systems 
#    Manager Parameter Store, and reference their ARNs in the ECS Task Definition.
# ==============================================================================

# Core Node Settings
NODE_ENV=production
PORT=5000

# CORS & Endpoint Security
# Explicitly restrict frontend CORS origins to prevent unauthorized access.
FRONTEND_URL=https://app.smaartminds.com

# Database Connection [SECRET]
# Production MongoURI must use TLS/SSL, replica sets, and point to private VPC endpoints.
# Example: mongodb+srv://smaartadmin:SECURE_PASSWORD@smaart-production.aws-region.mongodb.net/smaartminds?retryWrites=true&w=majority&maxPoolSize=50
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<db_cluster_endpoint>/<db_name>?retryWrites=true&w=majority

# JWT Token Security [SECRET]
# Must be a long, randomly generated cryptographical string (minimum 256-bit).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_SECURE_GENERATED_JWT_KEY_HERE

# AWS ElastiCache Serverless Redis Settings [SECRET]
# Point to your private VPC transit-encrypted Serverless Redis endpoint.
REDIS_HOST=smaart-redis-cluster.abcde1.serverless.aps1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=YOUR_REDIS_AUTH_TOKEN

# Third-Party AI Services & APIs [SECRET]
# OpenAI credentials for career intelligence / coach engines.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Image Storage & CDN Integration [SECRET]
# Cloudinary credentials for handling file & resume uploads.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# E-Mail Notifications SMTP Settings [SECRET]
# Use AWS SES (Simple Email Service) SMTP endpoints.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SES_SMTP_USERNAME
SMTP_PASS=YOUR_SES_SMTP_PASSWORD
EMAIL_FROM=noreply@smaartminds.com
