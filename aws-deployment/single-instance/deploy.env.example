# ============================================================================
# deploy.env.example — copy to .env in this directory before deploying.
#   cp deploy.env.example .env
#
# These values are consumed by docker-compose.prod.yml (CORS origins and
# frontend build args) and by bootstrap.sh (certificate issuance).
#
# This file holds NO secrets. Application secrets stay where they already are:
#   ../../back-end/.env                          (user dashboard)
#   ../../../SMAART-INSTITUTE-ADMIN/Backend/.env (admin)
# ============================================================================

# Public hostname of the user dashboard.
APP_DOMAIN=smaartinstitute.com

# Public hostname of the admin panel.
ADMIN_DOMAIN=admin.smaartinstitute.com

# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=institutesmaart@gmail.com
